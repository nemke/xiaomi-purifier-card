{
  "name": "breeze-purifier-card",
  "version": "0.1.13",
  "description": "Compact multi-brand air purifier dashboard card for Home Assistant",
  "main": "dist/xiaomi-purifier-card.js",
  "scripts": {
    "start": "rollup -c --watch",
    "lint": "npm run lint:src && npm run lint:translations",
    "lint:fix": "eslint src --fix",
    "lint:src": "eslint src",
    "lint:translations": "node scripts/validate-i18n",
    "format": "prettier --write .",
    "build": "rollup -c",
    "test": "npm run lint && npm run typecheck && npm run test:unit && npm run build && npm run test:browser",
    "prepare": "husky",
    "typecheck": "tsc --noEmit",
    "test:unit": "node --test tests/*.test.mjs",
    "test:browser": "playwright test",
    "test:blueprint": "python3 tests/blueprint_test.py"
  },
  "keywords": [
    "home-assistant",
    "homeassistant",
    "hass",
    "automation",
    "lovelace",
    "custom-cards",
    "purifier"
  ],
  "author": {
    "name": "Denys Dovhan",
    "email": "denysdovhan@gmail.com",
    "url": "http://denysdovhan.com"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/nemke/xiaomi-purifier-card.git"
  },
  "license": "MIT",
  "dependencies": {
    "custom-card-helpers": "^2.0.0",
    "ha-template": "^1.4.1",
    "home-assistant-js-websocket": "^9.6.0",
    "lit": "^3.3.2",
    "lodash": "^4.17.21"
  },
  "devDependencies": {
    "@babel/core": "^7.28.5",
    "@babel/plugin-transform-runtime": "^7.28.5",
    "@babel/preset-env": "^7.28.5",
    "@eslint/js": "^9.39.2",
    "@playwright/test": "^1.64.1",
    "@rollup/plugin-babel": "^7.0.0",
    "@rollup/plugin-commonjs": "^29.0.0",
    "@rollup/plugin-image": "^3.0.3",
    "@rollup/plugin-json": "^6.1.0",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-replace": "^6.0.3",
    "@rollup/plugin-terser": "^1.0.0",
    "@types/lodash": "^4.14.195",
    "@typescript-eslint/eslint-plugin": "^8.51.0",
    "@typescript-eslint/parser": "^8.51.0",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "globals": "^17.0.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.4",
    "postcss-preset-env": "^11.1.2",
    "prettier": "^3.7.4",
    "rollup": "^4.59.0",
    "rollup-plugin-minify-html-literals-v3": "^1.3.4",
    "rollup-plugin-postcss": "^4.0.2",
    "rollup-plugin-postcss-lit": "^2.2.0",
    "rollup-plugin-serve": "^3.0.0",
    "rollup-plugin-typescript2": "^0.37.0",
    "typescript": "^5.9.3"
  },
  "browserslist": [
    "last 2 versions",
    "not dead"
  ],
  "lint-staged": {
    "*.js": "eslint --fix",
    "**/*": "prettier --write --ignore-unknown"
  },
  "prettier": {
    "singleQuote": true
  },
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24",
    "npm": ">=11"
  },
  "contributors": [
    {
      "name": "nemke",
      "url": "https://github.com/nemke"
    }
  ]
}
